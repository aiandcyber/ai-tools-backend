OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_STT_MODEL=openai/whisper-1

# LLM routing: auto | openrouter | gemini
LLM_PROVIDER=auto
# Retry with Gemini once if primary fails (needs GEMINI_API_KEY)
LLM_FALLBACK_GEMINI=true
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# When true: LLM tools + /api/chat require a valid Auth0 Bearer token
AUTH_REQUIRED=true
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.ai-forall.org

# Comma-separated browser origins allowed to call this API
# Local + Cloudflare Pages production host
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://tools.ai-forall.org

PORT=8000

# Cloudflare Turnstile. Dummy secret + action "test" are for local dummy sitekeys only.
# Production: real TURNSTILE_SECRET, host tools.ai-forall.org (no localhost).
# Actions: contact (feedback form), search (casual /api/search).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_ACTION=test
TURNSTILE_ACTIONS=contact,search,test
SEARCH_TURNSTILE_ACTION=search
# Casual anonymous search (Option B): max requests per IP per window
SEARCH_CASUAL_RATE_LIMIT=30
SEARCH_CASUAL_RATE_WINDOW_SEC=60
# App → API search (Option C): Auth0 M2M or user Bearer JWT (AUTH0_* above). No static API keys in code.
JOB_ROOT=/tmp/ai-tools-jobs
# Global fallback max upload (bytes). Per-tool overrides: tool_id=bytes,...
# MAX_UPLOAD_BYTES=83886080
# MAX_UPLOAD_BYTES_BY_TOOL=stt=41943040,video_translate=83886080
MAX_UPLOAD_BYTES=83886080

# Shared SearXNG service (do not embed SearXNG in this image)
# Local: http://127.0.0.1:8080
# Production: internal URL of the shared SearXNG service
SEARXNG_URL=http://127.0.0.1:8080
SEARCH_DEFAULT_REGION=HK
# Slim Search API (knowledge graph + policy). Empty = in-process SearXNG fallback.
SEARCH_API_URL=
